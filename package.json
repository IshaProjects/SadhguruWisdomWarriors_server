{
  "name": "wisdom-warriors-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test:classify": "node scripts/test-classification.js",
    "mongo:local": "bash scripts/setup-local-mongodb.sh",
