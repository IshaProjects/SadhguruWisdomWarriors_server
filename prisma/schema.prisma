// Wisdom Warriors — Postgres schema (Phase 1 of Mongo→Postgres migration).
//
// Faithful port of the 12 Mongoose models (src/models/*.js) plus a junction
// table for MicroUnit ↔ Channel many-to-many. During ETL the Mongo _id hex
// string is preserved as the row's primary key so every FK lines up without
// remapping; new rows generated by the app get @default(cuid()).
//
// Naming: PascalCase model names, snake_case @@map / @map for table/column
// names. JSON-shape fields (Mixed in Mongo) become Jsonb. Snapshot `date`
// columns are normalised to UTC midnight by the upstream code — see
// scripts/migrate-snapshot-dates-to-utc.js and src/utils/dateUtc.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/* ─────────────────────────────────────────────────────────────────────
   Enums
───────────────────────────────────────────────────────────────────── */

enum Role {
  admin
  manager
  viewer
  poc
}

enum UserStatus {
  pending
  approved
  rejected
}

enum ChannelStatus {
  active
  paused
  // Not posting recently but still tracked and counted everywhere.
  inactive
  // Reserved for soft-deleted channels (set together with deletedAt).
  archived
}

enum VideoQueueType {
  viral
  normal
  event
  educational
  other
}

enum VideoQueuePriority {
  high
  normal
  low
}

enum VideoQueueStatus {
  queued
  processing
  completed
  failed
}

enum SyncLogSyncType {
  channel
  video
  dedicated_ingest
  ihi_ingest
  ihi_sadhguru_stats
}

enum SyncLogType {
  auto
  manual
}

enum SyncLogStatus {
  running
  success
  partial
  failed
}

/* ─────────────────────────────────────────────────────────────────────
   Users / auth
───────────────────────────────────────────────────────────────────── */

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  password            String
  name                String
  role                Role        @default(viewer)
  status              UserStatus  @default(approved) @map("status")
  refreshToken        String?     @map("refresh_token")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt      @map("updated_at") @db.Timestamptz(6)

  assignedChannels   Channel[]   @relation("ChannelAssignedTo")
  assignedMicroUnits MicroUnit[] @relation("MicroUnitPoc")

  @@map("users")
}

/* ─────────────────────────────────────────────────────────────────────
   Categories
───────────────────────────────────────────────────────────────────── */

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz(6)

  @@map("categories")
}

/* ─────────────────────────────────────────────────────────────────────
   Channels  (currentStats.* is flattened into three indexed columns)
───────────────────────────────────────────────────────────────────── */

model Channel {
  id                        String        @id @default(cuid())
  youtubeChannelId          String        @unique @map("youtube_channel_id")
  title                     String        @default("")
  description               String        @default("")
  thumbnailUrl              String        @default("") @map("thumbnail_url")
  bannerUrl                 String        @default("") @map("banner_url")
  customUrl                 String        @default("") @map("custom_url")
  country                   String        @default("")
  publishedAt               DateTime?     @map("published_at")        @db.Timestamptz(6)
  uploadsPlaylistId         String        @default("") @map("uploads_playlist_id")

  category                  String        @default("Uncategorized")
  tags                      String[]      @default([])
  assignedToId              String?       @map("assigned_to_id")
  assignedTo                User?         @relation("ChannelAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  status                    ChannelStatus @default(active)
  notes                     String        @default("")

  // Flattened from Mongo currentStats.{subscribers,views,videoCount}.
  currentSubscribers        Int           @default(0) @map("current_subscribers")
  currentViews              BigInt        @default(0) @map("current_views")
  currentVideoCount         Int           @default(0) @map("current_video_count")

  lastSyncedAt              DateTime?     @map("last_synced_at")              @db.Timestamptz(6)
  allVideosPulled           Boolean       @default(false) @map("all_videos_pulled")
  autoArchivedForInactivity Boolean       @default(false) @map("auto_archived_for_inactivity")

  deletedAt                 DateTime?     @map("deleted_at")                  @db.Timestamptz(6)
  createdAt                 DateTime      @default(now()) @map("created_at")  @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt      @map("updated_at")  @db.Timestamptz(6)

  videos            Video[]
  channelSnapshots  ChannelSnapshot[]
  videoSnapshots    VideoSnapshot[]
  microUnitChannels MicroUnitChannel[]

  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@index([currentSubscribers(sort: Desc)])
  @@index([currentViews(sort: Desc)])
  @@index([status, autoArchivedForInactivity])
  @@map("channels")
}

/* ─────────────────────────────────────────────────────────────────────
   Videos  (classification stays plain String — '', 'sadhguru', 'non sadhguru')
───────────────────────────────────────────────────────────────────── */

model Video {
  id             String    @id @default(cuid())
  youtubeVideoId String    @unique @map("youtube_video_id")
  channelId      String    @map("channel_id")
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title          String    @default("")
  description    String    @default("")
  thumbnailUrl   String    @default("") @map("thumbnail_url")
  publishedAt    DateTime? @map("published_at")    @db.Timestamptz(6)
  views          BigInt    @default(0)
  likes          Int       @default(0)
  comments       Int       @default(0)
  duration       String    @default("")
  lastSyncedAt   DateTime? @map("last_synced_at")  @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at")      @db.Timestamptz(6)
  classification String    @default("")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt      @map("updated_at") @db.Timestamptz(6)

  videoSnapshots VideoSnapshot[]

  @@index([channelId])
  @@index([deletedAt])
  @@index([channelId, publishedAt(sort: Desc)])
  @@index([views(sort: Desc)])
  @@index([channelId, classification])
  @@map("videos")
}

/* ─────────────────────────────────────────────────────────────────────
   Channel snapshots  (one row per (channel, UTC-midnight date))
───────────────────────────────────────────────────────────────────── */

model ChannelSnapshot {
  id          String    @id @default(cuid())
  channelId   String    @map("channel_id")
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Timestamptz(6)
  subscribers Int       @default(0)
  views       BigInt    @default(0)
  videoCount  Int       @default(0) @map("video_count")
  deletedAt   DateTime? @map("deleted_at")  @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt      @map("updated_at") @db.Timestamptz(6)

  @@unique([channelId, date])
  @@index([date])
  @@index([deletedAt])
  @@index([channelId, date(sort: Desc)])
  @@map("channel_snapshots")
}

/* ─────────────────────────────────────────────────────────────────────
   Video snapshots  (one row per (video, UTC-midnight date))
───────────────────────────────────────────────────────────────────── */

model VideoSnapshot {
  id        String    @id @default(cuid())
  videoId   String    @map("video_id")
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channelId String    @map("channel_id")
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Timestamptz(6)
  views     BigInt    @default(0)
  likes     Int       @default(0)
  comments  Int       @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt      @map("updated_at") @db.Timestamptz(6)

  @@unique([videoId, date])
  @@index([channelId])
  @@index([date])
  @@index([deletedAt])
  @@index([channelId, date(sort: Desc)])
  @@map("video_snapshots")
}

/* ─────────────────────────────────────────────────────────────────────
   MicroUnit  +  junction (channelIds array becomes M2M)
───────────────────────────────────────────────────────────────────── */

model MicroUnit {
  id        String   @id @default(cuid())
  name      String
  notes     String   @default("")
  pocId     String?  @map("poc_id")
  poc       User?    @relation("MicroUnitPoc", fields: [pocId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz(6)

  microUnitChannels MicroUnitChannel[]

  @@map("micro_units")
}

model MicroUnitChannel {
  microUnitId String    @map("micro_unit_id")
  channelId   String    @map("channel_id")
  microUnit   MicroUnit @relation(fields: [microUnitId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([microUnitId, channelId])
  @@index([channelId])
  @@map("micro_unit_channels")
}

/* ─────────────────────────────────────────────────────────────────────
   Video ingest queue
───────────────────────────────────────────────────────────────────── */

model VideoQueueItem {
  id           String              @id @default(cuid())
  url          String
  title        String              @default("")
  videoType    VideoQueueType      @default(normal) @map("video_type")
  eventName    String              @default("")     @map("event_name")
  notes        String              @default("")
  priority     VideoQueuePriority  @default(normal)
  status       VideoQueueStatus    @default(queued)
  errorMessage String              @default("")     @map("error_message")
  addedBy      String              @default("")     @map("added_by")
  startedAt    DateTime?           @map("started_at")   @db.Timestamptz(6)
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now())  @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt       @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([priority, status, createdAt])
  @@map("video_queue_items")
}

/* ─────────────────────────────────────────────────────────────────────
   Sync logs  (errors array → Jsonb so we can keep the [{channelId,message}] shape)
───────────────────────────────────────────────────────────────────── */

model SyncLog {
  id                String           @id @default(cuid())
  syncType          SyncLogSyncType  @default(channel) @map("sync_type")
  type              SyncLogType
  status            SyncLogStatus    @default(running)
  channelsProcessed Int              @default(0) @map("channels_processed")
  videosProcessed   Int              @default(0) @map("videos_processed")
  quotaUsed         Int              @default(0) @map("quota_used")
  errors            Json             @default("[]") @db.JsonB
  startedAt         DateTime         @default(now()) @map("started_at")   @db.Timestamptz(6)
  completedAt       DateTime?        @map("completed_at")                 @db.Timestamptz(6)

  @@index([syncType, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("sync_logs")
}

/* ─────────────────────────────────────────────────────────────────────
   Singletons  (one row, fixed id)
───────────────────────────────────────────────────────────────────── */

model SyncConfig {
  // SyncConfig.getSingleton() → upsert on this literal id.
  id                       String   @id @default("sync")
  channelSyncSchedule      String   @default("0 3 * * *")    @map("channel_sync_schedule")
  videoSyncSchedule        String   @default("0 4 * * *")    @map("video_sync_schedule")
  dedicatedIngestSchedule  String   @default("0 0 * * *")    @map("dedicated_ingest_schedule")
  ihiIngestSchedule        String   @default("0 */6 * * *")  @map("ihi_ingest_schedule")
  ihiSadhguruStatsSchedule String   @default("0 5 * * *")    @map("ihi_sadhguru_stats_schedule")
  channelSyncEnabled       Boolean  @default(true)           @map("channel_sync_enabled")
  videoSyncEnabled         Boolean  @default(true)           @map("video_sync_enabled")
  dedicatedIngestEnabled   Boolean  @default(true)           @map("dedicated_ingest_enabled")
  ihiIngestEnabled         Boolean  @default(true)           @map("ihi_ingest_enabled")
  ihiSadhguruStatsEnabled  Boolean  @default(true)           @map("ihi_sadhguru_stats_enabled")
  inactivityThresholdDays  Int      @default(14)             @map("inactivity_threshold_days")
  createdAt                DateTime @default(now())          @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt               @map("updated_at") @db.Timestamptz(6)

  @@map("sync_config")
}

model RbacConfig {
  // Embedded permission entries (pages/actions) kept as Jsonb arrays. Shape:
  //   [{ key: string, label: string, roles: { admin: bool, manager: bool, viewer: bool } }, ...]
  id        String   @id @default("rbac")
  pages     Json     @default("[]") @db.JsonB
  actions   Json     @default("[]") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz(6)

  @@map("rbac_config")
}

model DashboardLayout {
  // react-grid-layout responsive layouts keyed by breakpoint, e.g. { lg, md, sm }.
  id        String   @id @default("layout")
  layouts   Json     @default("{}") @db.JsonB
  updatedBy String   @default("") @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz(6)

  @@map("dashboard_layout")
}
