# Copy to .env and fill in values.
# For Digital Ocean App Platform, set these as App-Level or Component Environment Variables.
# Use different values per environment (e.g. dev vs prod) so each environment has its own database.

PORT=5000
NODE_ENV=production

# MongoDB (required)
#
# Local (pick one):
#   • Docker: from repo root run `docker compose up -d` (see ../docker-compose.yml)
#   • No Docker: `cd scripts && ./setup-local-mongodb.sh` (downloads MongoDB to ~/.local/share/...)
#   Then set:
# MONGODB_URI=mongodb://127.0.0.1:27017/
# MONGODB_DB_NAME=yt_dashboard_dev
#
# Atlas (cloud): use Connect → Drivers in the Atlas UI (real hostname, not "cluster.mongodb.net").
# MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER_HOST.mongodb.net/
#
# Optional: database name. Overrides database in URI.
MONGODB_DB_NAME=yt_dashboard_dev
MONGODB_URI=mongodb://127.0.0.1:27017/

# PostgreSQL / Supabase (migration target — Prisma).
# From the Supabase dashboard: Connect → ORMs → Prisma. Region should match the app server.
#   DATABASE_URL = transaction-mode pooler (port 6543, ?pgbouncer=true) — used by the app at runtime.
#   DIRECT_URL   = session-mode pooler  (port 5432) — used by `prisma migrate`.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# JWT (required – use long random strings in production)
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# YouTube Data API (required for channel sync)
YOUTUBE_API_KEY=your-youtube-api-key
DAILY_QUOTA_LIMIT=10000

# Optional
SYNC_CRON_SCHEDULE=0 3 * * *

# Video classification (choose one):
# Option A: Gemini API — get key from https://aistudio.google.com/app/apikey (simplest)
GEMINI_API_KEY=

# Option B: Vertex AI (requires GCP project with Vertex AI API enabled)
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_AI_LOCATION=us-central1
# Credentials: use file path (local) OR JSON string (DigitalOcean, serverless)
# GOOGLE_APPLICATION_CREDENTIALS=./keys/your-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# VERTEX_AI_MODEL=gemini-2.0-flash-001
