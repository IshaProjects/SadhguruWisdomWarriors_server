# Copy to .env and fill in values.
# For Digital Ocean App Platform, set these as App-Level or Component Environment Variables.
# Use different values per environment (e.g. dev vs prod) so each environment has its own database.

PORT=5000
NODE_ENV=production

# MongoDB (required)
# Full connection string. Can include database name: ...mongodb.net/your_db_name
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Optional: database name. Overrides database in URI. Use different names per environment:
#   development: yt_dashboard_dev
#   production:  yt_dashboard_prod
MONGODB_DB_NAME=

# JWT (required – use long random strings in production)
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# YouTube Data API (required for channel sync)
YOUTUBE_API_KEY=your-youtube-api-key
DAILY_QUOTA_LIMIT=10000

# Optional
SYNC_CRON_SCHEDULE=0 3 * * *
