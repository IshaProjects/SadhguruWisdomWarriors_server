# Copy to .env and fill in values.
# For Digital Ocean App Platform, set these as App-Level or Component Environment Variables.

PORT=5000
NODE_ENV=production

# MongoDB (required)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# JWT (required – use long random strings in production)
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# YouTube Data API (required for channel sync)
YOUTUBE_API_KEY=your-youtube-api-key
DAILY_QUOTA_LIMIT=10000

# Optional
SYNC_CRON_SCHEDULE=0 3 * * *
